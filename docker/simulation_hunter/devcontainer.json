{
	"build": {
		"args": {
			// set the base version of the image we use, e.g. "humble_dev" or "staging". "staging" begin the latest github build (wether PR or branch), 
			// usually this should be a released version, e.g. 0.0.8 or simply "0")
			//"BASE_VERSION": "0.0.8", 
			//"BASE_VERSION": "humble_dev", 
			"BASE_VERSION": "humble_dev",
			// the platform to use, e.g. "hunter_platform" or "dogtooth_platform"
			"ROBOT_PLATFORM": "hunter_platform"
		},
		"context": ".",
		"options": [
			"--pull"	// always pull the latest base image
		],
		"dockerfile": "../devcontainer.dockerfile"
	},
	"capAdd": [
		"NET_ADMIN",
		"SYS_PTRACE"
	],
	"containerEnv": {
		"MONGOD_PORT": "27018",	// mongodb port
		"ROS_DOMAIN_ID": "1"	// we use ROS_DOMAIN_ID=1 as a default here. Change for different scenarios.
		//"AOC_PRIVILEGED": "1",
		//"ROS_DOMAIN_ID": "0",
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"GitHub.vscode-pull-request-github",
				"JaehyunShim.vscode-ros2",
				"ms-vscode.cpptools",
				"ms-azuretools.vscode-docker",
				"mongodb.mongodb-vscode",
				"AlessandroSofia.ros2-topic-viewer"
			]
		}
	},
	"forwardPorts": [
		5801,
		27018
	],
	"hostRequirements": {
		"cpus": 2,
		"gpu": "optional",
		"memory": "7gb"
	},
	// the initializeCommand is used to create the .aoc-ws-cache folder in the user's home directory. This folder is
	// used as the workspace root, allowing the user to persist the workspace between container restarts.
	"initializeCommand": "mkdir -p ${localEnv:HOME}/.aoc-ws-cache",
	// various mounts, among them the mounting of the .aoc-ws-cache folder which is used as the workspace root, allowing
	// the user to persist the workspace between container restarts. See also "initializeCommand".
	"mounts": [
		"source=/etc/timezone,target=/etc/timezone,type=bind,readonly",
		"source=/etc/localtime,target=/etc/localtime,type=bind,readonly",
		"source=${localEnv:HOME}/.aoc-ws-cache,target=/home/ros/aoc_strawberry_scenario_ws,type=bind",
		"source=${localWorkspaceFolder}/.devcontainer/docker/ros2/config/dds_configs,target=/etc/dds_configs,type=bind,readonly",
		"source=/media,target=/media,type=bind"
	],
	"name": "Simulated Hunter",
	"portsAttributes": {
		"27018": {
			"label": "mongodb"
		},
		"5801": {
			"label": "novnc (accelerated)",
			"onAutoForward": "openPreview"
		}
	},
	"postCreateCommand": "src/aoc_strawberry_scenario/.devcontainer/docker/ros2/script/post_create.sh",
	"remoteUser": "ros",
	"runArgs": [
		//"--privileged",
		//"--dev /dev",
	],
	"securityOpt": [ 
		"seccomp=unconfined" 
	],
	"updateRemoteUserUID": true,
	"overrideCommand": false,
	"workspaceFolder": "/home/ros/aoc_strawberry_scenario_ws",
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/aoc_strawberry_scenario_ws/src/aoc_strawberry_scenario,type=bind"
}